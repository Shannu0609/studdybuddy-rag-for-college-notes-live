# Application
APP_NAME="Study Buddy AI"
APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https://.*\.netlify\.app$|^http://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+)(:\d+)?$

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Database (SQLite by default; switch to postgresql+psycopg://... if using PostgreSQL)
DATABASE_URL=sqlite:///./data/study_buddy.db

# File Uploads & Vector Store
UPLOAD_DIR=./uploads
CHROMA_PERSIST_DIR=./data/chroma_db
MAX_FILE_SIZE_MB=25

# Embeddings & RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_CHUNKS=6
MIN_SIMILARITY_SCORE=0.12

# Google Gemini API (Keep private on backend!)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional Redis Cache
REDIS_URL=

# Optional SMTP for Password Reset Emails (if unset, reset tokens are logged to backend console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

